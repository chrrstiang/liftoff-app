{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    "drizzle.config.ts",
    // Test doubles live under src/ because the unit-test config uses `rootDir: src`
