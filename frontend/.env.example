# Copy to frontend/.env and fill in. Never commit .env.
#
# WARNING: everything prefixed EXPO_PUBLIC_ is inlined into the shipped app
# bundle and is readable by anyone with the binary. Only the Supabase ANON key
# belongs here — never the service-role key, which bypasses RLS.
#
# These are read at bundle time, so restart Metro with --clear after changing them.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase ANON / publishable key (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_KEY=

# Origin of the NestJS API. "localhost" does NOT resolve from a physical device
# or emulator — use your machine's LAN IP there, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
