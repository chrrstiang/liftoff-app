{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "\\.e2e[-.]spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  },
  "globalSetup": "<rootDir>/helpers/global-setup.ts",
  "globalTeardown": "<rootDir>/helpers/global-teardown.ts",
  "maxWorkers": 1,
  "testPathIgnorePatterns": [
    "<rootDir>/helpers/"
  ],
  "testTimeout": 60000
}
