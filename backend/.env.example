# Copy to backend/.env and fill in. Never commit .env.
#
# SupabaseService throws at construction if either Supabase value is missing,
# so the API will not boot without them.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_PROJECT_URL=

# Supabase SERVICE-ROLE key (Project Settings -> API).
# This bypasses Row Level Security entirely: every query in the backend must
# scope itself to the authenticated user. Never log it, and never move it to
# anything prefixed EXPO_PUBLIC_.
SUPABASE_SECRET_KEY=

# Supabase legacy JWT secret (Settings -> API -> JWT Secret).
# Lets JwtAuthGuard verify access tokens locally with HMAC-SHA256 instead of a
# network round trip to supabase.auth.getUser() on every authenticated request.
# Without it the guard still works, but falls back to that remote call — which
# means every authenticated endpoint goes down whenever the Supabase project is
# unreachable or paused, not just login.
# This is a SECRET: anyone holding it can mint valid tokens for any user. Never
# log it, and never move it to anything prefixed EXPO_PUBLIC_.
SUPABASE_JWT_SECRET=

# Optional
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
